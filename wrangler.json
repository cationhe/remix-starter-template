{
	"name": "remix-starter-template",
	"compatibility_date": "2025-10-08",
	"main": "./server.ts",
	"routes": [
		{
			"pattern": "7103308.cfd/*",
			"zone_name": "7103308.cfd"
		}
	],
	"vars": {
		"SESSION_SECRET": "dev-only-session-secret-change-me",
		"SUPERADMIN_EMAIL": "7103308@qq.com",
		"PUBLIC_BASE_URL": "https://7103308.cfd",
		"EMAIL_PROVIDER": "auto",
		"EMAIL_FROM": "noreply@7103308.cfd"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "forum_db",
			"database_id": "8f8e4030-d303-4077-b3ae-f9d6567bb7a3"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "7103308"
		}
	],
	"assets": {
		"directory": "./build/client"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
